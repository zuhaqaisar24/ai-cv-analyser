# Copy this file to .env.local. Never commit .env.local.
#
# Leave OPENAI_API_KEY empty to run in mock mode: the CV profile is
# sample data, and no request is sent to OpenAI.
OPENAI_API_KEY=

# Set to true to force mock mode even when a key is present.
MOCK_LLM=false

# Chat model used for structured extraction.
# gpt-4o-mini supports the JSON schema this project sends.
OPENAI_MODEL=gpt-4o-mini
