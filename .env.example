# Copy this file to .env.local. Never commit .env.local.
#
# Free key from https://aistudio.google.com/apikey
# Leave this empty to stay in test mode (sample profile, no API call).
GEMINI_API_KEY=

# Optional alternative. Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=

# Set to true to force test mode even when a key is present.
MOCK_LLM=false

# Optional chat model. Default is gemini-2.5-flash.
# With only an OpenAI key, the default is gpt-4o-mini unless you set this.
# AI_MODEL=gemini-2.5-flash
